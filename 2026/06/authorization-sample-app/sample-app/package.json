{
  "name": "sample-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "npx auth@latest generate --config ./src/shared/auth/server.ts --output ./src/shared/db/auth-schema.ts --yes",
    "dev": "next dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "tsx ./scripts/migrate.ts",
    "db:seed": "tsx ./scripts/seed.ts",
    "db:push": "drizzle-kit push",
    "build": "next build",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:expense-request-authz": "node --test --experimental-strip-types \"src/contexts/expense-request/**/*.test.ts\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "start": "next start"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.9",
    "@open-policy-agent/opa-wasm": "1.10.0",
    "better-auth": "1.6.9",
    "casbin": "5.50.0",
    "drizzle-adapter": "1.4.0",
    "drizzle-orm": "0.45.2",
    "nanoid": "5.1.9",
    "next": "16.2.4",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "24.12.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
